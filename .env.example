# Environment variables (do NOT commit real secrets)
# Copy this file to .env.local and fill values for local dev,
# or add to Vercel Project Settings → Environment Variables.

# Primary provider (default): Gmail SMTP via Nodemailer
# These must be set to enable SMTP sending in /api/request-cv.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=

# Alternative provider: Resend (optional). If set, the API can send via Resend.
RESEND_API_KEY=

# Example (Gmail App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=youraddress@gmail.com
# MAIL_FROM_NAME=Your Name
